# Database Connection Settings
# Configured for PostgreSQL (default) or SQLite fallback for testing
DB_DIALECT=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_analytics
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Pipeline Settings
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
LOG_LEVEL=INFO
RANDOM_STATE=42

# Power BI Export Settings
POWERBI_EXPORT_DIR=powerbi/data
